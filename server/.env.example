# Copia este archivo a .env y rellena los valores.
# Genera secretos con:  openssl rand -base64 32

# Base de datos (docker-compose construye DATABASE_URL con esta contraseña)
POSTGRES_PASSWORD=
# Solo en desarrollo sin Docker:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/delicias

# Firma de las sesiones del personal
JWT_SECRET=

# Dominios del frontend permitidos (separados por comas, sin barra final).
# "*" sirve de comodín para las URLs que Vercel crea en cada despliegue.
CORS_ORIGINS=https://lasdelicias.orpira.es,https://lasdelicias-orpira-7163s-projects.vercel.app,https://lasdelicias-*-orpira-7163s-projects.vercel.app

# URL pública de esta API (para las URLs de las fotos subidas)
PUBLIC_URL=https://api-delicias.orpira.es

# Proxys cuya cabecera X-Forwarded-For se cree (IPs, CIDR o loopback, linklocal, uniquelocal).
# El valor por defecto cubre un proxy en el mismo servidor o en una red Docker privada.
# TRUST_PROXY=loopback,uniquelocal

# n8n: webhook que recibe los eventos (pedido.creado, pedido.estado, mesa.llamada)
# y secreto con el que la API los firma (HMAC-SHA256 + marca de tiempo + id de evento).
# El secreto no viaja en las peticiones; sin él la API no envía nada a n8n.
N8N_WEBHOOK_URL=https://n8n.orpira.es/webhook/las-delicias
N8N_WEBHOOK_SECRET=

# Clave con la que n8n llama a la API (cabecera X-Api-Key) para crear pedidos de WhatsApp
N8N_API_KEY=

# Caja registradora (TPV): ninguno | loyverse | revo | agora
# Con "ninguno" el stock de envasados se lleva en la app o lo envía n8n a POST /n8n/stock
TPV_PROVEEDOR=ninguno
TPV_INTERVALO_MIN=5
LOYVERSE_TOKEN=
LOYVERSE_STORE_ID=
REVO_TENANT=
REVO_TOKEN=
AGORA_URL=
AGORA_TOKEN=

LOG_LEVEL=info

# Red Docker compartida con el proxy (la detecta instalar.sh)
PROXY_NETWORK=lasdelicias-proxy
