      "id": "192aa8c3-910b-4b46-9e2f-83d9a0800006",
      "name": "Avisar por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [340, -300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CAMBIAR_CREDENCIAL_EVOLUTION",
          "name": "CAMBIAR_CREDENCIAL_EVOLUTION"
        }
      },
      "notes": "Selecciona Header Auth con cabecera apikey y sustituye la instancia en la URL. Contrato number/text contrastado con Evolution API v2.2.3 y v2.3.7. Sin reintentos automáticos para evitar mensajes duplicados."
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "CAMBIAR_CHAT_ID_GRUPO_PERSONAL",
        "text": "={{ (() => { const llamada = $json.body.llamada; const mesa = llamada.mesa_nombre?.trim() || 'Mesa ' + llamada.mesa_numero; const mensaje = llamada.motivo === 'cuenta' ? `🧾 ${mesa} pide la cuenta` : `🙋 ${mesa} llama al personal`; return mensaje.replace(/[&<>]/g, caracter => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[caracter]); })() }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "192aa8c3-910b-4b46-9e2f-83d9a0800007",
      "name": "Avisar al personal por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [340, -40],
      "credentials": {
        "telegramApi": {
          "id": "CAMBIAR_CREDENCIAL_TELEGRAM",
          "name": "CAMBIAR_CREDENCIAL_TELEGRAM"
        }
      }
    },
