    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const pedido = $json.body.pedido;\nlet telefono = String(pedido.telefono).replace(/[\\s()+-]/g, '');\n\nif (telefono.startsWith('00')) telefono = telefono.slice(2);\nif (/^[6789]\\d{8}$/.test(telefono)) telefono = `34${telefono}`;\n\nif (!/^[1-9]\\d{6,14}$/.test(telefono)) {\n  throw new Error('El teléfono del pedido no tiene un formato internacional válido.');\n}\n\nlet mensaje;\nif ($json.body.tipo === 'pedido.creado' && pedido.fuera_horario === true) {\n  const apertura = new Date(pedido.atender_desde);\n  if (typeof pedido.atender_desde !== 'string' || !Number.isFinite(apertura.getTime())) {\n    throw new Error('El pedido programado no tiene una fecha de apertura válida.');\n  }\n  const dia = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', weekday: 'long', day: 'numeric', month: 'long' }).format(apertura);\n  const hora = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(apertura);\n  mensaje = `¡Hola ${pedido.nombre_cliente}! Hemos recibido tu pedido #${pedido.numero_dia} en Las Delicias. Ahora estamos cerrados: lo prepararemos el ${dia} a partir de las ${hora} y te avisaremos cuando esté listo. ¡Gracias!`;\n} else {\n  mensaje = `¡Hola ${pedido.nombre_cliente}! Tu pedido #${pedido.numero_dia} de Las Delicias ya está listo. Pasa a recogerlo por la barra 😊`;\n}\n\nreturn { json: { telefono, mensaje } };"
      },
