    },
    {
      "parameters": {
        "jsCode": "// Primer filtro de los eventos de la API (firma completa en los dos nodos siguientes).\n// Descarta marcas de tiempo fuera de ±5 min e ids de evento ya vistos (anti-replay)\n// y prepara el texto que firma la API: \"<timestamp>.<evento>.<cuerpo>\" (ver server/src/firma.js).\nconst TOLERANCIA_S = 300;\nconst MAX_RECORDADOS = 5000;\nconst visto = $getWorkflowStaticData('global');\nvisto.eventos = visto.eventos ?? {};\nconst ahora = Math.floor(Date.now() / 1000);\nfor (const [id, ts] of Object.entries(visto.eventos)) if (ahora - ts > 2 * TOLERANCIA_S) delete visto.eventos[id];\n\nconst salida = [];\nfor (const item of $input.all()) {\n  const h = item.json.headers ?? {};\n  const ts = Number(h['x-delicias-timestamp']);\n  const id = String(h['x-delicias-evento'] ?? '');\n  const firma = String(h['x-delicias-firma'] ?? '');\n  if (!Number.isInteger(ts) || Math.abs(ahora - ts) > TOLERANCIA_S) continue;\n  if (!/^[0-9a-f-]{36}$/.test(id) || visto.eventos[id] || item.json.body?.evento_id !== id) continue;\n  if (!/^v1=[0-9a-f]{64}$/.test(firma)) continue;\n  if (Object.keys(visto.eventos).length >= MAX_RECORDADOS) continue;\n  visto.eventos[id] = ts;\n  // La API envía JSON.stringify(evento); volver a serializarlo reproduce los mismos bytes\n  salida.push({ json: { ...item.json, firma_base: ts + '.' + id + '.' + JSON.stringify(item.json.body), firma_recibida: firma.slice(3) } });\n}\nreturn salida;"
      },
